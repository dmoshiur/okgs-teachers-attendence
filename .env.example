# Turso database (libSQL). Use a file: URL for local development if you prefer.
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# First-run admin. Only used to seed the admins table when it is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Session signing secret. Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Optional default school name (can be changed later in Settings).
SCHOOL_NAME=Your School Name
